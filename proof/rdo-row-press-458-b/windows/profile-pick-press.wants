wait_until tp-address-zip_code-note --timeout-ms 2000 --screenshot
# Error line, ZIP: text that fits nothing, then Save below it, on the first click.
click tp-address-zip_code-search
key tp-address-zip_code-search mod+a
type tp-address-zip_code-search zzzz --key-delay-ms 80
wait_until tp-address-zip_code-nothing --timeout-ms 3000
click tp-address-save --screenshot
wait_until tp-address-save --absent --timeout-ms 5000 --screenshot
click tb-panel
wait_until panel-open-profile --absent --timeout-ms 5000
