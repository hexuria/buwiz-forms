# Desktop, the New taxpayer form that setup-start.wants opened: the RDO combobox under a person's pace.
# - Five presses on a row right after typing "makati" (the #425 Windows fault: at c4262697 the box's blur came before the
#   row's press, so the box went back to its last pick 0/5).
# - Three chevron presses, open and closed.
# - Three presses away on the Name box with "makati" typed: the list closes, the last pick stays, the note shows.
# Each round selects the box's text first (mod+a), as a person does in a box that already has the keys: a click there
# only moves the caret. The "makati" list has four rows, so press 5 is 047 again. Driven by gpui-agent's press: on Windows it is the real
# pointer path (nsh-platform-windows agent.rs click -> synth::pointer -> input::pointer -> focus_pointer).
# Row press 1/5: 047.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-opt-047 --timeout-ms 5000
click new-tp-rdo_code-opt-047 --screenshot
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
# Row press 2/5: 048.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-opt-048 --timeout-ms 5000
click new-tp-rdo_code-opt-048
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="048 — West Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
# Row press 3/5: 049.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-opt-049 --timeout-ms 5000
click new-tp-rdo_code-opt-049
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="049 — North Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
# Row press 4/5: 050.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-opt-050 --timeout-ms 5000
click new-tp-rdo_code-opt-050
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="050 — South Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
# Row press 5/5: 047.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-opt-047 --timeout-ms 5000
click new-tp-rdo_code-opt-047 --screenshot
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
# Chevron 1/3: opens the whole list, closes it again; the box keeps 047.
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
# Chevron 2/3: opens the whole list, closes it again; the box keeps 047.
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
# Chevron 3/3: opens the whole list, closes it again; the box keeps 047.
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-rdo_code-trigger --screenshot
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
# Click away 1/3: "makati" fits several choices; a press on another box closes the list, the box keeps 047 and says so.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-name
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --timeout-ms 2000
# Click away 2/3: "makati" fits several choices; a press on another box closes the list, the box keeps 047 and says so.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-name
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --timeout-ms 2000
# Click away 3/3: "makati" fits several choices; a press on another box closes the list, the box keeps 047 and says so.
click new-tp-rdo_code-search
key new-tp-rdo_code-search mod+a
type new-tp-rdo_code-search makati --key-delay-ms 80
wait_until new-tp-rdo_code-list --timeout-ms 3000
click new-tp-name
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --timeout-ms 2000 --screenshot
# Leave the form as sign-up expects it: a press back in the RDO box clears its note (the box's focus clears it), with
# nothing typed, so the next press elsewhere only closes.
click new-tp-rdo_code-search
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
