# Phone runtime adaptation: phone has no desktop context-pill/profile panel surface, so the left-state proof is form + Filings search only.
# OTP first textbox id n3 was observed in a fresh real-window run; second sign-in is replaced by the fixture's stable switch-account seam.
wait_until gate-start --timeout-ms 15000
click gate-start-continue
wait_until gate-email --timeout-ms 10000
set_value gate-email juana@example.com
click gate-continue
wait_until gate-code-boxes --timeout-ms 10000
type n3 246810
wait_until home-dashboard --timeout-ms 20000
click home-tp-000123453-next
wait_until form-page --timeout-ms 30000
click tab-filings
wait_until filings-search --timeout-ms 10000 --screenshot
set_value filings-search juana
click demo-sign-out
wait_until gate-start --timeout-ms 10000
click demo-switch-account
wait_until frame --timeout-ms 20000 --screenshot
wait_until form-page --absent --timeout-ms 1000
wait_until filings-search --absent --timeout-ms 1000
