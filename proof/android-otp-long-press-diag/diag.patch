+package com.longbridge.nsh;
+
+import android.os.Build;
+import android.text.Layout;
+import android.util.Log;
+import android.view.ActionMode;
+import android.view.Menu;
+import android.view.MenuItem;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.widget.EditText;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.HashSet;
+
+/** Job 57 diagnostic logging only: stock/NSH EditText selection and action-mode facts. */
+final class J57Diag {
+    private static final HashSet<String> PROPS_LOGGED = new HashSet<>();
+
+    private J57Diag() {}
+
+    static String id(EditText edit) {
+        return Integer.toHexString(System.identityHashCode(edit));
+    }
+
+    static void install(EditText edit, String tag) {
+        ActionMode.Callback selection = edit.getCustomSelectionActionModeCallback();
+        if (!(selection instanceof LogCallback)) {
+            edit.setCustomSelectionActionModeCallback(new LogCallback(tag, "selection", selection));
+        }
+        if (Build.VERSION.SDK_INT >= 23) {
+            ActionMode.Callback insertion = edit.getCustomInsertionActionModeCallback();
+            if (!(insertion instanceof LogCallback)) {
+                edit.setCustomInsertionActionModeCallback(new LogCallback(tag, "insertion", insertion));
+            }
+        }
+    }
+
+    static void propsOnce(EditText edit, String tag) {
+        String key = tag + ":" + System.identityHashCode(edit);
+        synchronized (PROPS_LOGGED) {
+            if (!PROPS_LOGGED.add(key)) return;
+        }
+        Object movement = edit.getMovementMethod();
+        Log.i(tag, "props longClickable=" + edit.isLongClickable()
+                + " textSelectable=" + edit.isTextSelectable()
+                + " focusable=" + edit.isFocusable()
+                + " focusableInTouchMode=" + edit.isFocusableInTouchMode()
+                + " movement=" + (movement == null ? "null" : movement.getClass().getName())
+                + " edit." + listeners(edit));
+        StringBuilder chain = new StringBuilder("parents edit");
+        ViewParent parent = edit.getParent();
+        int depth = 0;
+        while (parent instanceof View && depth < 40) {
+            View view = (View) parent;
+            chain.append(" > ").append(view.getClass().getName())
+                    .append('[').append(interceptor(view.getClass())).append(',')
+                    .append(listeners(view)).append(']');
+            parent = view.getParent();
+            depth++;
+        }
+        chain.append(" > ").append(parent == null ? "null" : parent.getClass().getName());
+        Log.i(tag, chain.toString());
+    }
+
+    static void layout(EditText edit, String tag, String why) {
+        int[] at = new int[2];
+        edit.getLocationOnScreen(at);
+        Layout layout = edit.getLayout();
+        String x0 = "?", x4 = "?", x9 = "?";
+        if (layout != null) {
+            x0 = horizontal(layout, 0);
+            x4 = horizontal(layout, 4);
+            x9 = horizontal(layout, 9);
+        }
+        Log.i(tag, "layout " + why
+                + " rect=" + at[0] + "," + at[1] + "," + (at[0] + edit.getWidth()) + "," + (at[1] + edit.getHeight())
+                + " padding=" + edit.getPaddingLeft() + "," + edit.getPaddingTop() + ","
+                + edit.getPaddingRight() + "," + edit.getPaddingBottom()
+                + " compoundPadding=" + edit.getCompoundPaddingLeft() + "," + edit.getCompoundPaddingTop() + ","
+                + edit.getCompoundPaddingRight() + "," + edit.getCompoundPaddingBottom()
+                + " scroll=" + edit.getScrollX() + "," + edit.getScrollY()
+                + " glyph0=" + x0 + " glyph4=" + x4 + " glyph9=" + x9
+                + " textLength=" + edit.length());
+    }
+
+    private static String horizontal(Layout layout, int offset) {
+        try {
+            return Float.toString(layout.getPrimaryHorizontal(offset));
+        } catch (RuntimeException e) {
+            return "err:" + e.getClass().getSimpleName();
+        }
+    }
+
+    private static String interceptor(Class<?> cls) {
+        Class<?> c = cls;
+        while (c != null && c != ViewGroup.class) {
+            try {
+                c.getDeclaredMethod("onInterceptTouchEvent", MotionEvent.class);
+                return "intercept=" + c.getName();
+            } catch (NoSuchMethodException ignored) {
+            }
+            c = c.getSuperclass();
+        }
+        return "intercept=android.view.ViewGroup";
+    }
+
+    private static String listeners(View view) {
+        try {
+            Method get = View.class.getDeclaredMethod("getListenerInfo");
+            get.setAccessible(true);
+            Object info = get.invoke(view);
+            if (info == null) return "longClickListener=false touchListener=false";
+            Class<?> cls = info.getClass();
+            Field longClick = cls.getDeclaredField("mOnLongClickListener");
+            Field touch = cls.getDeclaredField("mOnTouchListener");
+            longClick.setAccessible(true);
+            touch.setAccessible(true);
+            return "longClickListener=" + (longClick.get(info) != null)
+                    + " touchListener=" + (touch.get(info) != null);
+        } catch (Throwable t) {
+            return "longClickListener=? touchListener=? (" + t.getClass().getSimpleName() + ")";
+        }
+    }
+
+    private static String items(Menu menu) {
+        if (menu == null) return "null";
+        StringBuilder out = new StringBuilder("[");
+        for (int i = 0; i < menu.size(); i++) {
+            MenuItem item = menu.getItem(i);
+            if (i != 0) out.append(',');
+            if (item == null) {
+                out.append("null");
+                continue;
+            }
+            out.append(item.getItemId()).append(':').append(item.getTitle())
+                    .append(item.isEnabled() ? ":enabled" : ":disabled")
+                    .append(item.isVisible() ? ":visible" : ":hidden");
+        }
+        return out.append(']').toString();
+    }
+
+    private static final class LogCallback implements ActionMode.Callback {
+        private final String tag;
+        private final String kind;
+        private final ActionMode.Callback inner;
+
+        LogCallback(String tag, String kind, ActionMode.Callback inner) {
+            this.tag = tag;
+            this.kind = kind;
+            this.inner = inner;
+        }
+
+        @Override
+        public boolean onCreateActionMode(ActionMode mode, Menu menu) {
+            boolean keep = inner == null || inner.onCreateActionMode(mode, menu);
+            Log.i(tag, "am create kind=" + kind + " keep=" + keep + " items=" + items(menu));
+            return keep;
+        }
+
+        @Override
+        public boolean onPrepareActionMode(ActionMode mode, Menu menu) {
+            boolean keep = inner == null || inner.onPrepareActionMode(mode, menu);
+            Log.i(tag, "am prepare kind=" + kind + " keep=" + keep + " items=" + items(menu));
+            return keep;
+        }
+
+        @Override
+        public boolean onActionItemClicked(ActionMode mode, MenuItem item) {
+            return inner != null && inner.onActionItemClicked(mode, item);
+        }
+
+        @Override
+        public void onDestroyActionMode(ActionMode mode) {
+            Log.i(tag, "am destroy kind=" + kind + " items=" + items(mode == null ? null : mode.getMenu()));
+            if (inner != null) inner.onDestroyActionMode(mode);
+        }
+    }
+}
