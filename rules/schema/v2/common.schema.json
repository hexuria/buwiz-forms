{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldcoders.dev/schemas/ebirforms/v2/common.schema.json",
  "title": "eBIRForms executable rules IR v2 common types",
  "$defs": {
    "schema_version": {
      "const": "2.0.0"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 255
    },
    "rule_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-p[0-9]+(?:\\.[0-9]+)*$",
      "minLength": 1,
      "maxLength": 160
    },
    "form_code": {
      "type": "string",
      "pattern": "^[0-9]{4}[A-Z-]*$",
      "minLength": 4,
      "maxLength": 16
    },
    "iso_date": {
      "type": "string",
      "format": "date"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rules_relative_path": {
      "type": "string",
      "pattern": "^(?:forms|shared|ir/v2)/[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "minLength": 1,
      "maxLength": 320
    },
    "value_type": {
      "enum": [
        "null",
        "string",
        "boolean",
        "integer",
        "decimal",
        "date"
      ]
    },
    "branch_state": {
      "enum": [
        "executable",
        "documented_only",
        "unresolved"
      ]
    },
    "review_status": {
      "enum": [
        "skeleton",
        "candidate",
        "reviewed"
      ]
    },
    "behavior_profile": {
      "enum": [
        "official",
        "filing_safe"
      ]
    },
    "validation_phase": {
      "enum": [
        "input",
        "blur",
        "change",
        "blur-change",
        "page-navigation",
        "save",
        "draft-preview",
        "validate",
        "final-copy",
        "submit"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "assessment": {
      "enum": [
        "verified-correct",
        "official-bug-compatible",
        "incorrect-official-behavior",
        "ambiguous",
        "unverified",
        "obsolete"
      ]
    },
    "severity": {
      "enum": [
        "advisory",
        "blocking"
      ]
    },
    "source_kind": {
      "enum": [
        "legacy-v1-manifest",
        "legacy-v1-fields",
        "legacy-v1-validations",
        "legacy-v1-calculations",
        "legacy-v1-workflow",
        "legacy-v1-negative-fixtures",
        "legacy-v1-calculation-fixtures",
        "official-package-executable",
        "runtime-extracted-hta",
        "runtime-help",
        "official-form-pdf",
        "official-guidelines-pdf",
        "xml-editable-save",
        "xml-final-copy",
        "repository-code",
        "repository-test",
        "review-decision"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/source_kind"
        },
        "path": {
          "$ref": "#/$defs/rules_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        }
      },
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_ref"
      },
      "minItems": 1
    },
    "field_instance_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "singleton"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "current-group-instance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "instance_id"
          ],
          "properties": {
            "kind": {
              "const": "stable-instance-id"
            },
            "instance_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evaluation_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "singleton"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "group_id"
          ],
          "properties": {
            "kind": {
              "const": "each-group"
            },
            "group_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "derived_instance_selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "singleton"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "current-group-instance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "instance_id"
          ],
          "properties": {
            "kind": {
              "const": "stable-instance-id"
            },
            "instance_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "field_ref": {
      "type": "object",
      "required": [
        "field_id",
        "instance"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/$defs/identifier"
        },
        "instance": {
          "$ref": "#/$defs/field_instance_ref"
        }
      },
      "additionalProperties": false
    },
    "typed_value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "$ref": "decimal.schema.json#/$defs/decimal_literal"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "$ref": "#/$defs/iso_date"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "runtime_stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,253}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 255,
      "description": "Exact wire alphabet accepted by the bir-rules stable-ID newtypes."
    },
    "runtime_form_code": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$",
      "minLength": 1,
      "maxLength": 255
    },
    "form_revision_key": {
      "type": "object",
      "required": [
        "rule_set_id",
        "form_code",
        "form_revision",
        "official_package_version",
        "source_set_sha256"
      ],
      "properties": {
        "rule_set_id": {
          "$ref": "#/$defs/runtime_stable_id"
        },
        "form_code": {
          "$ref": "#/$defs/runtime_form_code"
        },
        "form_revision": {
          "$ref": "#/$defs/runtime_stable_id"
        },
        "official_package_version": {
          "$ref": "#/$defs/runtime_stable_id"
        },
        "source_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "validation_context": {
      "type": "object",
      "required": [
        "phase",
        "profile"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/validation_phase"
        },
        "profile": {
          "$ref": "#/$defs/behavior_profile"
        }
      },
      "additionalProperties": false
    },
    "input_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "context_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "documented_branch": {
      "type": "object",
      "required": [
        "state",
        "summary",
        "source_refs"
      ],
      "properties": {
        "state": {
          "const": "documented_only"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      },
      "additionalProperties": false
    },
    "unresolved_branch": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "source_refs"
      ],
      "properties": {
        "state": {
          "const": "unresolved"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      },
      "additionalProperties": false
    },
    "profile_status_executable": {
      "type": "object",
      "required": [
        "state",
        "review_decision",
        "source_refs"
      ],
      "properties": {
        "state": {
          "const": "executable"
        },
        "review_decision": {
          "$ref": "#/$defs/source_ref"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      },
      "additionalProperties": false
    },
    "profile_status_branch": {
      "oneOf": [
        {
          "$ref": "#/$defs/profile_status_executable"
        },
        {
          "$ref": "#/$defs/documented_branch"
        },
        {
          "$ref": "#/$defs/unresolved_branch"
        }
      ]
    },
    "profile_status": {
      "type": "object",
      "required": [
        "official",
        "filing_safe"
      ],
      "properties": {
        "official": {
          "$ref": "#/$defs/profile_status_branch"
        },
        "filing_safe": {
          "$ref": "#/$defs/profile_status_branch"
        }
      },
      "additionalProperties": false
    }
  }
}
