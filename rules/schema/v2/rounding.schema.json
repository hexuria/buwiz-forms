{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldcoders.dev/schemas/ebirforms/v2/rounding.schema.json",
  "title": "eBIRForms executable rules IR v2 rounding nodes",
  "$defs": {
    "rounding": {
      "type": "object",
      "required": [
        "mode",
        "scale"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "half-up",
            "half-even",
            "half-ceiling",
            "toward-zero",
            "away-from-zero",
            "floor",
            "ceiling"
          ]
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/rounding"
}
