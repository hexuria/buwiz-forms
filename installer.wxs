<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="eBIRForms" Language="1033" Version="$(var.Version)" Manufacturer="GoldCoders" UpgradeCode="e8a5f36b-9c17-4e62-9721-a1b2c3d4e5f6">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="eBIRForms" Level="1">
            <ComponentGroupRef Id="HarvestedComponents" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="eBIRForms" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="eBIRForms"/>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="f6e5d4c3-21a7-4e62-9721-e8a5f36b9c17">
                <Shortcut Id="ApplicationStartMenuShortcut" 
                          Name="eBIRForms" 
                          Description="eBIRForms Desktop Application"
                          Target="[INSTALLDIR]bir.exe"
                          WorkingDirectory="INSTALLDIR"/>
                <Shortcut Id="ApplicationDesktopShortcut"
                          Directory="DesktopFolder"
                          Name="eBIRForms"
                          Description="eBIRForms Desktop Application"
                          Target="[INSTALLDIR]bir.exe"
                          WorkingDirectory="INSTALLDIR"/>
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\GoldCoders\eBIRForms" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <UIRef Id="WixUI_InstallDir" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    </Product>
</Wix>
