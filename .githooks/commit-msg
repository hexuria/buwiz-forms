#!/bin/sh
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "commit-msg hook: not inside a git repository" >&2
    exit 1
}
if command -v python3 >/dev/null 2>&1; then
    python_bin=python3
elif command -v python >/dev/null 2>&1; then
    python_bin=python
else
    echo "commit-msg hook: python3 or python is required" >&2
    exit 1
fi
exec "$python_bin" "$root/scripts/commit_message_paths.py" message-file "$1"
