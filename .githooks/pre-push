#!/bin/sh
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-push hook: not inside a git repository" >&2
    exit 1
}
python_choice=
if command -v python >/dev/null 2>&1 && python -c "import sys; sys.exit(sys.version_info < (3, 7))" >/dev/null 2>&1; then
    python_choice=python
elif command -v py >/dev/null 2>&1 && py -3 -c "import sys; sys.exit(sys.version_info < (3, 7))" >/dev/null 2>&1; then
    python_choice=py
elif command -v python3 >/dev/null 2>&1 && python3 -c "import sys; sys.exit(sys.version_info < (3, 7))" >/dev/null 2>&1; then
    python_choice=python3
else
    echo "pre-push hook: no working Python; local-path check skipped" >&2
    exit 0
fi
case "$python_choice" in
    python)  exec python "$root/scripts/commit_message_paths.py" pre-push ;;
    py)      exec py -3 "$root/scripts/commit_message_paths.py" pre-push ;;
    python3) exec python3 "$root/scripts/commit_message_paths.py" pre-push ;;
esac
