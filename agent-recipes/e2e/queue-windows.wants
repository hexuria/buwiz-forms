# Smoke 8, pre-send, windows: open a fresh 2551Q for Q2 (the earlier recipes use the default Q4), answer what validation
# wants, and stop before the Queue control after Check reports no problems. The send rehearsal is queue-send.
# What validation still wants is in the to-do list and in Part I: capture the list, jump to Part I and answer its
# items (income type goes to the profile inline, exactly what the box says).
click sb-new
wait_until new-return-2551Q --timeout-ms 5000
click new-return-2551Q
click new-return-period-trigger
wait_until new-return-period-opt-2 --timeout-ms 5000
click new-return-period-opt-2
click new-return-open
wait_until form-page --timeout-ms 20000 --screenshot
click fp-pill-list --screenshot
click fp-nav-attention --screenshot
click 'fp-ask-tax_classification-choices-"SelfEmployed"'
type fp-frm2551Qv2018:telNo 09170000000
type fp-txtEmail#occurrence-1 e2e@example.com
click fp-frm2551Qv2018:taxTreaty_2 --screenshot
# Jump back to the top after the low Part I answers: deep in the scroll the toolbar is culled from the tree and fp-queue is gone.
click fp-frm2551Qv2018:taxRateNA --screenshot
click fp-nav-0 --screenshot
click fp-check
wait_until fp-pill-count --timeout-ms 1000 --absent
wait_until fp-queue --timeout-ms 5000 --screenshot
wait_until queue-confirm --timeout-ms 1000 --absent
