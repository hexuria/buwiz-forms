# Smoke 9, phone: Log out at the end of the tax profile sheet (a press inside a sheet: gpui-agent gap 1); the lock screen
# comes up.
click nb-avatar
wait_until nb-menu-profile --timeout-ms 5000
click nb-menu-profile
wait_until sheet-logout --timeout-ms 5000
click sheet-logout
wait_until locked-screen --timeout-ms 10000 --screenshot
