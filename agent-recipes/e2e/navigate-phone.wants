# Smoke 3, phone: every tab of the tab bar, ending on Home with the taxpayer's tile.
click tab-library
wait_until library-search --timeout-ms 5000 --screenshot
click tab-filings
wait_until filings-search --timeout-ms 5000 --screenshot
click tab-calendar
wait_until calendar-narrow --timeout-ms 5000 --screenshot
click tab-home
wait_until home-tp-$tin_root --timeout-ms 5000 --screenshot
