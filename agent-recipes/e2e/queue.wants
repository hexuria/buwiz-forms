# Smoke 8, pre-send: Queue on the open return, in the dry-run test build only (the default suite never presses it).
# Queue validates first: a 2551Q on a profile without the business start date and the annual income-tax election
# stops at its prerequisite banners. So this recipe first records both through the banners' own Set buttons (each
# opens the profile editor and returns to the form on save). The election is 8%: it makes Item 13 Not applicable
# for a Q4 non-initial quarter. Then the remaining to-dos are answered in the form itself, and Check must report
# no problems before the recipe stops with Queue visible and its confirm dialog unopened.
wait_until fp-set-profile-business_start_date --timeout-ms 8000 --screenshot
click fp-set-profile-business_start_date
wait_until tp-branch-business_start_date --timeout-ms 5000
click tp-branch-business_start_date
type tp-branch-business_start_date $bstart
assert tp-branch-business_start_date value=$bstart
click tp-branch-save
wait_until fp-set-profile-income_tax_election --timeout-ms 8000 --screenshot
click fp-set-profile-income_tax_election
wait_until tp-fact-income_tax_election-choice-EightPercent --timeout-ms 5000
click tp-fact-income_tax_election-choice-EightPercent
click tp-fact-income_tax_election-save
wait_until fp-pill-list --timeout-ms 8000 --screenshot
click fp-pill-list --screenshot
click fp-nav-attention --screenshot
click 'fp-ask-tax_classification-choices-"SelfEmployed"'
type fp-frm2551Qv2018:telNo 09170000000
type fp-txtEmail#occurrence-1 e2e@example.com
click fp-frm2551Qv2018:taxTreaty_2 --screenshot
click fp-frm2551Qv2018:taxRateNA --screenshot
click fp-nav-0 --screenshot
click fp-check
wait_until 'No problems found.' --timeout-ms 10000 --screenshot
wait_until fp-queue --timeout-ms 5000 --screenshot
wait_until queue-confirm --timeout-ms 1000 --absent
