# two-accounts 1: A signs in through the real sign-in page (the mock, first code).
wait_until gate-start --timeout-ms 30000 --screenshot
click gate-start-continue
wait_until gate-email-page --timeout-ms 10000
type gate-email $account_a
click gate-continue
wait_until gate-code-page --timeout-ms 15000 --screenshot
type gate-code-boxes $code_1
