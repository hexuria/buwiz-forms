# two-accounts, plain after A's sign-in: the arrival at Home is proven HERE (a sign-in
# recipe may not assert Home), then A's tax profile, a draft, and sign-out.
wait_until home --timeout-ms 30000 --screenshot
wait_until setup-solo --timeout-ms 30000
click setup-solo
wait_until new-tp-name --timeout-ms 5000
click new-tp-start-trigger
wait_until $start_option --timeout-ms 5000
click $start_option
type $tin_field $tin_a
click new-tp-name
type new-tp-name $name_a
type new-tp-registered_address $address_a
click new-tp-zip_code-trigger
wait_until new-tp-zip_code-search --timeout-ms 5000
type new-tp-zip_code-search $zip
wait_until new-tp-zip_code-opt-$zip --timeout-ms 5000
click new-tp-zip_code-opt-$zip
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-search --timeout-ms 5000
type new-tp-rdo_code-search $rdo
wait_until new-tp-rdo_code-opt-$rdo --timeout-ms 5000
click new-tp-rdo_code-opt-$rdo
click new-tp-save --screenshot
wait_until nav-home --timeout-ms 10000
assert context-pill name="Tax profile: $name_a" --screenshot
click sb-new
wait_until new-return-2551Q --timeout-ms 5000
click new-return-2551Q
click new-return-open
wait_until form-page --timeout-ms 20000 --screenshot
click nav-settings
wait_until settings-account-sign-out --timeout-ms 10000
click settings-account-sign-out
wait_until settings-sign-out-yes --timeout-ms 5000
click settings-sign-out-yes
wait_until gate-start --timeout-ms 20000 --screenshot
