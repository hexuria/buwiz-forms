# rdo-row-press.wants without pacing (an older gpui-agent-cli): each "makati" sent as one type request. A fault seen
# only here, not in the paced run, is not a finding.
click new-tp-rdo_code-search
type new-tp-rdo_code-search makati
wait_until new-tp-rdo_code-opt-047 --timeout-ms 5000
click new-tp-rdo_code-opt-047 --screenshot
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
click new-tp-rdo_code-search
type new-tp-rdo_code-search makati
wait_until new-tp-rdo_code-opt-048 --timeout-ms 5000
click new-tp-rdo_code-opt-048
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="048 — West Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
click new-tp-rdo_code-search
type new-tp-rdo_code-search makati
wait_until new-tp-rdo_code-opt-049 --timeout-ms 5000
click new-tp-rdo_code-opt-049
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="049 — North Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
click new-tp-rdo_code-search
type new-tp-rdo_code-search makati
wait_until new-tp-rdo_code-opt-050 --timeout-ms 5000
click new-tp-rdo_code-opt-050
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="050 — South Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000
click new-tp-rdo_code-search
type new-tp-rdo_code-search makati
wait_until new-tp-rdo_code-opt-047 --timeout-ms 5000
click new-tp-rdo_code-opt-047 --screenshot
wait_until new-tp-rdo_code-list --absent --timeout-ms 3000
assert new-tp-rdo_code-search value="047 — East Makati"
wait_until new-tp-rdo_code-note --absent --timeout-ms 2000 --screenshot
