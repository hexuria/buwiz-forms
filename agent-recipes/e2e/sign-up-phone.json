{
 "v": 1,
 "name": "e2e-sign-up-phone",
 "app": "bir-shell",
 "params": [
  "tin",
  "name",
  "address",
  "zip",
  "rdo",
  "start_option",
  "tin_field"
 ],
 "steps": [
  {
   "id": "s1",
   "op": "wait_until",
   "target": "new-tp-name",
   "timeout_ms": 5000
  },
  {
   "id": "s2",
   "op": "click",
   "target": "new-tp-start-trigger"
  },
  {
   "id": "s3",
   "op": "wait_until",
   "target": "$start_option",
   "timeout_ms": 5000
  },
  {
   "id": "s4",
   "op": "click",
   "target": "$start_option"
  },
  {
   "id": "s5",
   "op": "wait_until",
   "target": "$start_option",
   "timeout_ms": 5000,
   "exists": false
  },
  {
   "id": "s6",
   "op": "set_value",
   "target": "$tin_field",
   "value": "$tin"
  },
  {
   "id": "s7",
   "op": "set_value",
   "target": "new-tp-name",
   "value": "$name"
  },
  {
   "id": "s8",
   "op": "set_value",
   "target": "new-tp-registered_address",
   "value": "$address"
  },
  {
   "id": "s9",
   "op": "click",
   "target": "new-tp-zip_code-trigger"
  },
  {
   "id": "s9a",
   "op": "wait_until",
   "target": "new-tp-zip_code-search",
   "timeout_ms": 5000
  },
  {
   "id": "s9b",
   "op": "type",
   "target": "new-tp-zip_code-search",
   "text": "$zip"
  },
  {
   "id": "s10",
   "op": "wait_until",
   "target": "new-tp-zip_code-opt-$zip",
   "timeout_ms": 5000
  },
  {
   "id": "s11",
   "op": "click",
   "target": "new-tp-zip_code-opt-$zip",
   "screenshot": true
  },
  {
   "id": "s12",
   "op": "wait_until",
   "target": "new-tp-zip_code-search",
   "timeout_ms": 5000,
   "exists": false
  },
  {
   "id": "s13",
   "op": "click",
   "target": "new-tp-rdo_code-trigger"
  },
  {
   "id": "s13a",
   "op": "wait_until",
   "target": "new-tp-rdo_code-search",
   "timeout_ms": 5000
  },
  {
   "id": "s13b",
   "op": "type",
   "target": "new-tp-rdo_code-search",
   "text": "$rdo"
  },
  {
   "id": "s14",
   "op": "wait_until",
   "target": "new-tp-rdo_code-list",
   "timeout_ms": 5000
  },
  {
   "id": "s15",
   "op": "scroll",
   "target": "new-tp-rdo_code-list",
   "dy": 950
  },
  {
   "id": "s16",
   "op": "scroll",
   "target": "new-tp-rdo_code-list",
   "dy": 950
  },
  {
   "id": "s17",
   "op": "wait_until",
   "target": "new-tp-rdo_code-opt-$rdo",
   "timeout_ms": 5000
  },
  {
   "id": "s18",
   "op": "click",
   "target": "new-tp-rdo_code-opt-$rdo",
   "screenshot": true
  },
  {
   "id": "s19",
   "op": "wait_until",
   "target": "new-tp-rdo_code-search",
   "timeout_ms": 5000,
   "exists": false
  },
  {
   "id": "s20",
   "op": "click",
   "target": "new-tp-save",
   "screenshot": true
  },
  {
   "id": "s21",
   "op": "wait_until",
   "target": "tp-page-forms",
   "timeout_ms": 10000,
   "screenshot": true
  },
  {
   "id": "s22",
   "op": "assert",
   "target": "tp-tabs"
  }
 ]
}
