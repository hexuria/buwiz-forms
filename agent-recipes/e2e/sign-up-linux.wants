# Smoke 2, linux: the first taxpayer as on a desktop (the ZIP and RDO pickers are popovers in a GTK window), in the
# narrow layout the 420 px wide Linux window shows: after Create the app is on the taxpayer's own page, and Home is
# tab-home. Every box is filled with set_value: machine-speed typed digits came out of order in the TIN cells on Linux
# (seen only under injected input; see docs/proof/E2E.md). $tin_field is the TIN's text box, whose id NSH generates:
# the runner reads it from a snapshot first.
click new-tp-start-trigger
wait_until $start_option --timeout-ms 5000
click $start_option
set_value $tin_field $tin
set_value new-tp-name $name
set_value new-tp-registered_address $address
click new-tp-zip_code-trigger
wait_until new-tp-zip_code-search --timeout-ms 5000
set_value new-tp-zip_code-search $zip
wait_until new-tp-zip_code-opt-$zip --timeout-ms 5000
click new-tp-zip_code-opt-$zip --screenshot
click new-tp-rdo_code-trigger
wait_until new-tp-rdo_code-search --timeout-ms 5000
set_value new-tp-rdo_code-search $rdo
wait_until new-tp-rdo_code-opt-$rdo --timeout-ms 5000
click new-tp-rdo_code-opt-$rdo --screenshot
click new-tp-save --screenshot
wait_until tp-tabs-profile --timeout-ms 10000
click tab-home
wait_until home-tp-$tin_root --timeout-ms 5000
assert home-tp-$tin_root --screenshot
