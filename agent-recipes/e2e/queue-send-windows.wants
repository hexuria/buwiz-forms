# Smoke 10, SEND, windows: the explicit dry-run send rehearsal. It runs after the pre-send queue recipe has validated
# the same open return, so it only presses Queue and Continue. The runner refuses it without --allow-send.
click fp-queue --screenshot
wait_until queue-continue --timeout-ms 10000 --screenshot
click queue-continue --screenshot
wait_until fp-send-line --timeout-ms 20000 --screenshot
