# Smoke 4, phone: the birth date through its date sheet (type the date in the sheet, Done), saved. Starts on Home with the
# taxpayer's tile, ends on the taxpayer's Profile tab. The presses inside the sheet are gpui-agent gap 1.
click home-tp-$tin
wait_until tp-tabs-profile --timeout-ms 5000
click tp-tabs-profile
wait_until tp-sec-taxpayer-edit --timeout-ms 5000
click tp-sec-taxpayer-edit
wait_until tp-taxpayer-birth_date --timeout-ms 5000
click tp-taxpayer-birth_date
wait_until tp-taxpayer-birth_date-sheet-input --timeout-ms 5000 --screenshot
set_value tp-taxpayer-birth_date-sheet-input $birth
click tp-taxpayer-birth_date-sheet-done
wait_until tp-taxpayer-birth_date-sheet-input --absent --timeout-ms 5000
click tp-taxpayer-save
wait_until tp-taxpayer-save --absent --timeout-ms 5000 --screenshot
