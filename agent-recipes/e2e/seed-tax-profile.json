{
 "v": 1,
 "name": "e2e-seed-tax-profile",
 "app": "bir-shell",
 "params": [
  "tin",
  "name",
  "rdo",
  "address",
  "zip"
 ],
 "steps": [
  {
   "id": "before",
   "op": "invoke",
   "name": "app.info"
  },
  {
   "id": "save",
   "op": "invoke",
   "name": "profile.save",
   "args": {
    "tin": "$tin",
    "name": "$name",
    "rdo_code": "$rdo",
    "registered_address": "$address",
    "zip_code": "$zip"
   },
   "needs": [
    "before"
   ]
  },
  {
   "id": "select",
   "op": "invoke",
   "name": "profile.set",
   "args": {
    "tin": "$tin",
    "view": "dashboard"
   },
   "needs": [
    "save"
   ]
  },
  {
   "id": "listed",
   "op": "invoke",
   "name": "profile.list",
   "needs": [
    "select"
   ]
  },
  {
   "id": "home",
   "op": "invoke",
   "name": "nav.go",
   "args": {
    "page": "home"
   },
   "needs": [
    "listed"
   ]
  }
 ]
}
