# profile-pick-press.wants without pacing (an older gpui-agent-cli): each text sent as one type request. A fault seen only here,
# not in the paced run, is not a finding.
click tb-panel
wait_until panel-open-profile --timeout-ms 5000
click panel-open-profile
wait_until tp-sec-branch-edit --timeout-ms 5000
click tp-sec-branch-edit
wait_until tp-branch-rdo_code-search --timeout-ms 5000 --screenshot
