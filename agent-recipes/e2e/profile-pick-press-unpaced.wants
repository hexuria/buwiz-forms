key tp-branch-rdo_code-search mod+a
type tp-branch-rdo_code-search makati
wait_until tp-branch-rdo_code-opt-047 --timeout-ms 5000
click tp-branch-rdo_code-opt-047 --screenshot
wait_until tp-branch-rdo_code-list --absent --timeout-ms 3000
assert tp-branch-rdo_code-search value="047 — East Makati"
wait_until tp-branch-rdo_code-note --absent --timeout-ms 2000
click tp-branch-rdo_code-search
key tp-branch-rdo_code-search mod+a
type tp-branch-rdo_code-search makati
