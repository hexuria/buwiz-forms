# Add 2025 through 2021 to the scratch taxpayer, copying the forms already on 2026. Ends on the Forms tab.
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-2025 --timeout-ms 5000
click tp-add-year-select-opt-2025
click tp-add-year-add
wait_until tp-years-2025 --timeout-ms 5000
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-2024 --timeout-ms 5000
click tp-add-year-select-opt-2024
click tp-add-year-add
wait_until tp-years-2024 --timeout-ms 5000
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-2023 --timeout-ms 5000
click tp-add-year-select-opt-2023
click tp-add-year-add
wait_until tp-years-2023 --timeout-ms 5000
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-2022 --timeout-ms 5000
click tp-add-year-select-opt-2022
click tp-add-year-add
wait_until tp-years-2022 --timeout-ms 5000
click tp-add-year-open
wait_until tp-add-year-select-trigger --timeout-ms 5000
click tp-add-year-select-trigger
wait_until tp-add-year-select-opt-2021 --timeout-ms 5000
click tp-add-year-select-opt-2021
click tp-add-year-add
wait_until tp-years-2021 --timeout-ms 5000
snapshot
