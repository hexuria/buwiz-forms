{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldcoders.dev/ebirforms/schema/linux-candidate-certification-attestation-v1.schema.json",
  "title": "External Linux candidate certification attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "promotion_eligible",
    "trusted_producer",
    "operator_only",
    "attestation_id",
    "form",
    "candidate",
    "collector",
    "runtime",
    "display_runs",
    "package_boundary",
    "strict_verifier_gaps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "const": "external_linux_candidate_certification_attestation" },
    "promotion_eligible": { "const": false },
    "trusted_producer": { "const": false },
    "operator_only": { "const": true },
    "attestation_id": { "type": "string", "format": "uuid" },
    "form": { "const": { "code": "2551Q", "revision": "2018" } },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_manifest_sha256",
        "candidate_archive_sha256",
        "source_revision",
        "installed_root_sha256",
        "installed_binary_sha256",
        "renderer_bundle_sha256",
        "renderer_identity_sha256",
        "installation_method"
      ],
      "properties": {
        "candidate_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_archive_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/gitRevision" },
        "installed_root_sha256": { "$ref": "#/$defs/sha256" },
        "installed_binary_sha256": { "$ref": "#/$defs/sha256" },
        "renderer_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "renderer_identity_sha256": { "$ref": "#/$defs/sha256" },
        "installation_method": { "const": "secure_portable_tar_extraction" }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "invocation_id",
        "started_at_utc",
        "completed_at_utc",
        "executable_sha256",
        "host_identifier_sha256"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "invocation_id": { "type": "string", "minLength": 1 },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "completed_at_utc": { "type": "string", "format": "date-time" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "host_identifier_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_dev_build",
        "dev_tools_enabled",
        "installed_root_sha256",
        "installed_binary_sha256",
        "assets_tree_sha256",
        "renderer_bundle_sha256",
        "renderer_identity_sha256",
        "artifact"
      ],
      "properties": {
        "non_dev_build": { "const": true },
        "dev_tools_enabled": { "const": false },
        "installed_root_sha256": { "$ref": "#/$defs/sha256" },
        "installed_binary_sha256": { "$ref": "#/$defs/sha256" },
        "assets_tree_sha256": { "$ref": "#/$defs/sha256" },
        "renderer_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "renderer_identity_sha256": { "$ref": "#/$defs/sha256" },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "display_runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x11", "wayland"],
      "properties": {
        "x11": { "$ref": "#/$defs/x11Run" },
        "wayland": { "$ref": "#/$defs/waylandRun" }
      }
    },
    "package_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_candidate_verified",
        "final_release_deb_verified",
        "final_release_tarball_verified",
        "release_package_signature_verified",
        "artifact"
      ],
      "properties": {
        "portable_candidate_verified": { "const": true },
        "final_release_deb_verified": { "const": false },
        "final_release_tarball_verified": { "const": false },
        "release_package_signature_verified": { "const": false },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "strict_verifier_gaps": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        { "contains": { "const": "collector producer is not registered as trusted" } },
        { "contains": { "const": "portable candidate bytes are not the final deb and release tarball bytes" } }
      ],
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_count", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "geometryMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_index",
        "page_width_pt",
        "page_height_pt",
        "pages",
        "clipping_count",
        "overflow_count"
      ],
      "properties": {
        "measurement_index": { "type": "integer", "minimum": 1, "maximum": 2 },
        "page_width_pt": { "const": 612 },
        "page_height_pt": { "const": 936 },
        "pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "x", "y", "width_pt", "height_pt"],
            "properties": {
              "page": { "type": "integer", "minimum": 1, "maximum": 2 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width_pt": { "const": 612 },
              "height_pt": { "const": 936 }
            }
          }
        },
        "clipping_count": { "const": 0 },
        "overflow_count": { "const": 0 }
      }
    },
    "pdfPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "media_width_pt",
        "media_height_pt",
        "crop_width_pt",
        "crop_height_pt",
        "rotation",
        "content_byte_count"
      ],
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 2 },
        "media_width_pt": { "const": 612 },
        "media_height_pt": { "const": 936 },
        "crop_width_pt": { "const": 612 },
        "crop_height_pt": { "const": 936 },
        "rotation": { "const": 0 },
        "content_byte_count": { "type": "integer", "minimum": 1 }
      }
    },
    "displayEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_variable",
        "display_value",
        "runtime_directory",
        "compositor",
        "compositor_version",
        "gtk_version",
        "webkitgtk_version",
        "artifact"
      ],
      "properties": {
        "display_variable": { "enum": ["DISPLAY", "WAYLAND_DISPLAY"] },
        "display_value": { "type": "string", "minLength": 1 },
        "runtime_directory": { "type": ["string", "null"] },
        "compositor": { "enum": ["Xvfb", "Weston"] },
        "compositor_version": { "type": "string", "minLength": 1 },
        "gtk_version": { "type": "string", "minLength": 1 },
        "webkitgtk_version": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "networkDenial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "exercised",
        "enforced_for_launch",
        "passed",
        "host_namespace_inode",
        "candidate_namespace_inode",
        "artifact"
      ],
      "properties": {
        "mechanism": { "type": "string", "pattern": "unshare-net" },
        "exercised": { "const": true },
        "enforced_for_launch": { "const": true },
        "passed": { "const": true },
        "host_namespace_inode": { "type": "string", "pattern": "^net:\\[[0-9]+\\]$" },
        "candidate_namespace_inode": { "type": "string", "pattern": "^net:\\[[0-9]+\\]$" },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opened", "preview_ready", "close_reopen", "clean_shutdown", "artifact"],
      "properties": {
        "opened": { "const": true },
        "preview_ready": { "const": true },
        "close_reopen": { "const": true },
        "clean_shutdown": { "const": true },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercised",
        "passed",
        "document_run_id",
        "envelope_sha256",
        "nonce",
        "page_count",
        "geometry_measurements",
        "artifact"
      ],
      "properties": {
        "exercised": { "const": true },
        "passed": { "const": true },
        "document_run_id": { "type": "string", "minLength": 1 },
        "envelope_sha256": { "$ref": "#/$defs/sha256" },
        "nonce": { "type": "integer", "minimum": 1 },
        "page_count": { "const": 2 },
        "geometry_measurements": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/geometryMeasurement" }
        },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "toolbarExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercised",
        "passed",
        "control",
        "save_chooser_exercised",
        "destination_path",
        "nonce",
        "artifact"
      ],
      "properties": {
        "exercised": { "const": true },
        "passed": { "const": true },
        "control": { "const": "Export PDF" },
        "save_chooser_exercised": { "const": true },
        "destination_path": { "type": "string", "minLength": 1 },
        "nonce": { "type": "integer", "minimum": 1 },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "nativePrint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercised", "passed", "completed", "printer_name", "job_id", "artifact"],
      "properties": {
        "exercised": { "const": true },
        "passed": { "const": true },
        "completed": { "const": true },
        "printer_name": { "type": "string", "minLength": 1 },
        "job_id": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "pdfValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercised",
        "passed",
        "output",
        "expected_page_count",
        "actual_page_count",
        "pages",
        "content_nonempty",
        "validated_by",
        "verifier_executable_sha256",
        "artifact"
      ],
      "properties": {
        "exercised": { "const": true },
        "passed": { "const": true },
        "output": { "$ref": "#/$defs/fileRecord" },
        "expected_page_count": { "const": 2 },
        "actual_page_count": { "const": 2 },
        "pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/pdfPage" }
        },
        "content_nonempty": { "const": true },
        "validated_by": { "const": "bir-print::html_output::validate_pdf_file" },
        "verifier_executable_sha256": { "$ref": "#/$defs/sha256" },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_root_sha256_before",
        "installed_root_sha256_after",
        "destination_before",
        "destination_after",
        "draft_before",
        "draft_after",
        "temporary_files_manifest"
      ],
      "properties": {
        "installed_root_sha256_before": { "$ref": "#/$defs/sha256" },
        "installed_root_sha256_after": { "$ref": "#/$defs/sha256" },
        "destination_before": { "$ref": "#/$defs/fileRecord" },
        "destination_after": { "$ref": "#/$defs/fileRecord" },
        "draft_before": { "$ref": "#/$defs/fileRecord" },
        "draft_after": { "$ref": "#/$defs/fileRecord" },
        "temporary_files_manifest": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "destination_preserved", "temporary_files_remaining", "draft_unchanged"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed", "artifact"],
            "properties": {
              "name": {
                "enum": [
                  "release_ready_false",
                  "kill_switch",
                  "missing_assets",
                  "renderer_error",
                  "late_renderer_error",
                  "readiness_timeout",
                  "invalid_geometry",
                  "rejected_pdf",
                  "destination_preserved",
                  "no_temp_leaks",
                  "draft_unchanged"
                ]
              },
              "passed": { "const": true },
              "artifact": { "$ref": "#/$defs/fileRecord" }
            }
          }
        },
        "destination_preserved": { "const": true },
        "temporary_files_remaining": { "const": 0 },
        "draft_unchanged": { "const": true }
      }
    },
    "baseRunProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercised",
        "passed",
        "display_server",
        "host_strategy",
        "app_owned_window",
        "external_browser",
        "window_title",
        "launch_argv",
        "pid",
        "display_environment",
        "network_denial",
        "lifecycle",
        "preview",
        "toolbar_export",
        "native_print",
        "pdf_validation",
        "integrity",
        "rollback",
        "artifact"
      ],
      "properties": {
        "exercised": { "const": true },
        "passed": { "const": true },
        "display_server": { "enum": ["x11", "wayland"] },
        "host_strategy": { "enum": ["GpuiWryChild", "GtkTopLevel"] },
        "app_owned_window": { "const": true },
        "external_browser": { "const": false },
        "window_title": { "enum": ["2551Q HTML Form Preview", "HTML Form Preview"] },
        "launch_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "pid": { "type": "integer", "minimum": 1 },
        "display_environment": { "$ref": "#/$defs/displayEnvironment" },
        "network_denial": { "$ref": "#/$defs/networkDenial" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "preview": { "$ref": "#/$defs/preview" },
        "toolbar_export": { "$ref": "#/$defs/toolbarExport" },
        "native_print": { "$ref": "#/$defs/nativePrint" },
        "pdf_validation": { "$ref": "#/$defs/pdfValidation" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "rollback": { "$ref": "#/$defs/rollback" },
        "artifact": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "x11Run": {
      "allOf": [
        { "$ref": "#/$defs/baseRunProperties" },
        {
          "type": "object",
          "properties": {
            "display_server": { "const": "x11" },
            "host_strategy": { "const": "GpuiWryChild" },
            "window_title": { "const": "2551Q HTML Form Preview" },
            "display_environment": {
              "allOf": [
                { "$ref": "#/$defs/displayEnvironment" },
                {
                  "properties": {
                    "display_variable": { "const": "DISPLAY" },
                    "runtime_directory": { "const": null },
                    "compositor": { "const": "Xvfb" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "waylandRun": {
      "allOf": [
        { "$ref": "#/$defs/baseRunProperties" },
        {
          "type": "object",
          "properties": {
            "display_server": { "const": "wayland" },
            "host_strategy": { "const": "GtkTopLevel" },
            "window_title": { "const": "HTML Form Preview" },
            "display_environment": {
              "allOf": [
                { "$ref": "#/$defs/displayEnvironment" },
                {
                  "properties": {
                    "display_variable": { "const": "WAYLAND_DISPLAY" },
                    "runtime_directory": { "type": "string", "minLength": 1 },
                    "compositor": { "const": "Weston" }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
