{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldcoders.dev/ebirforms/schema/macos-candidate-runtime-observation-v1.schema.json",
  "title": "Non-promotional macOS candidate runtime observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scope", "promotion_eligible", "trusted_producer",
    "collector_challenge_sha256", "form_code", "form_revision",
    "document_run_id_sha256", "envelope_sha256", "render_epoch",
    "readiness_revision", "issued_nonce", "preflight_consumptions",
    "backend_completion_nonce", "started_at_unix_ms", "completed_at_unix_ms",
    "geometry_reports", "output", "strict_verifier_gaps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "const": "macos_candidate_runtime_observation" },
    "promotion_eligible": { "const": false },
    "trusted_producer": { "const": false },
    "collector_challenge_sha256": { "$ref": "#/$defs/sha256" },
    "form_code": { "const": "2551Q" },
    "form_revision": { "const": "2018" },
    "document_run_id_sha256": { "$ref": "#/$defs/sha256" },
    "envelope_sha256": { "$ref": "#/$defs/sha256" },
    "render_epoch": { "type": "integer", "minimum": 1 },
    "readiness_revision": { "type": "integer", "minimum": 1 },
    "issued_nonce": { "type": "integer", "minimum": 1 },
    "preflight_consumptions": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "backend_completion_nonce": { "type": "integer", "minimum": 1 },
    "started_at_unix_ms": { "type": "integer", "minimum": 1 },
    "completed_at_unix_ms": { "type": "integer", "minimum": 1 },
    "geometry_reports": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/geometryReport" }
    },
    "output": {
      "oneOf": [
        { "$ref": "#/$defs/pdfOutput" },
        { "$ref": "#/$defs/printOutput" }
      ]
    },
    "strict_verifier_gaps": {
      "const": [
        "runtime_self_authored",
        "external_ui_and_print_required",
        "external_candidate_binding_required"
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "destinationSnapshot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status"], "properties": { "status": { "const": "absent" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "sha256"],
          "properties": { "status": { "const": "file" }, "sha256": { "$ref": "#/$defs/sha256" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason_code"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason_code": {
              "enum": ["metadata_read_failed", "not_regular_file", "file_read_failed"]
            }
          }
        }
      ]
    },
    "pagePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["page", "byte_count", "sha256"],
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 2 },
        "byte_count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pdfValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["page_count", "width_points", "height_points", "content_nonempty", "validated_by"],
      "properties": {
        "page_count": { "const": 2 }, "width_points": { "const": 612.0 },
        "height_points": { "const": 936.0 }, "content_nonempty": { "const": true },
        "validated_by": { "const": "bir-print::html_output::validate_pdf_file" }
      }
    },
    "geometryPage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "x", "y", "width", "height", "client_width", "client_height",
        "scroll_width", "scroll_height", "descendant_overflow_x",
        "descendant_overflow_y", "descendant_clipped_x", "descendant_clipped_y"
      ],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "client_width": { "type": "number" }, "client_height": { "type": "number" },
        "scroll_width": { "type": "number" }, "scroll_height": { "type": "number" },
        "descendant_overflow_x": { "const": 0 }, "descendant_overflow_y": { "const": 0 },
        "descendant_clipped_x": { "const": 0 }, "descendant_clipped_y": { "const": 0 }
      }
    },
    "geometryReport": {
      "type": "object", "additionalProperties": false,
      "required": ["page_count", "page_width_pt", "page_height_pt", "pages"],
      "properties": {
        "page_count": { "const": 2 }, "page_width_pt": { "const": 612.0 },
        "page_height_pt": { "const": 936.0 },
        "pages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/geometryPage" } }
      }
    },
    "pdfOutput": {
      "type": "object", "additionalProperties": false,
      "required": [
        "kind", "wkpdf_pages", "output_pdf_sha256", "output_pdf_byte_count",
        "pdf_validation", "destination_before", "destination_after", "temporary_file_remaining"
      ],
      "properties": {
        "kind": { "const": "pdf_export_succeeded" },
        "wkpdf_pages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/pagePayload" } },
        "output_pdf_sha256": { "$ref": "#/$defs/sha256" },
        "output_pdf_byte_count": { "type": "integer", "minimum": 1 },
        "pdf_validation": { "$ref": "#/$defs/pdfValidation" },
        "destination_before": { "$ref": "#/$defs/destinationSnapshot" },
        "destination_after": { "$ref": "#/$defs/destinationSnapshot" },
        "temporary_file_remaining": { "const": false }
      }
    },
    "printOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "appkit_completion_succeeded"],
      "properties": {
        "kind": { "const": "system_print_completed" },
        "appkit_completion_succeeded": { "const": true }
      }
    }
  }
}
