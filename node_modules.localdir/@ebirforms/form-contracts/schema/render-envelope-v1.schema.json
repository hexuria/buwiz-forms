{
  "$defs": {
    "RenderAlignment": {
      "enum": [
        "left",
        "center",
        "right"
      ],
      "type": "string"
    },
    "RenderColumn": {
      "properties": {
        "alignment": {
          "$ref": "#/$defs/RenderAlignment"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "alignment"
      ],
      "type": "object"
    },
    "RenderFormIdentity": {
      "properties": {
        "code": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "type": "object"
    },
    "RenderPeriod": {
      "properties": {
        "label": {
          "type": "string"
        },
        "month": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "quarter": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "taxable_year": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "taxable_year",
        "label"
      ],
      "type": "object"
    },
    "RenderRow": {
      "properties": {
        "cells": {
          "additionalProperties": {
            "$ref": "#/$defs/RenderValue"
          },
          "type": "object"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "cells"
      ],
      "type": "object"
    },
    "RenderSchedule": {
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/RenderColumn"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/RenderRow"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "RenderTaxpayer": {
      "properties": {
        "contact_number": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rdo_code": {
          "type": "string"
        },
        "registered_address": {
          "type": "string"
        },
        "tin": {
          "type": "string"
        },
        "zip_code": {
          "type": "string"
        }
      },
      "required": [
        "tin",
        "name",
        "rdo_code",
        "registered_address",
        "zip_code",
        "contact_number",
        "email"
      ],
      "type": "object"
    },
    "RenderValidationMessage": {
      "properties": {
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/RenderValidationSeverity"
        }
      },
      "required": [
        "field_path",
        "code",
        "message",
        "severity",
        "rule_version"
      ],
      "type": "object"
    },
    "RenderValidationSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    },
    "RenderValue": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "decimal",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://goldcoders.dev/schemas/render-envelope-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical eBIRForms renderer contract version 1.0",
  "properties": {
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/RenderValue"
      },
      "type": "object"
    },
    "form": {
      "$ref": "#/$defs/RenderFormIdentity"
    },
    "locale": {
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/RenderPeriod"
    },
    "schedules": {
      "items": {
        "$ref": "#/$defs/RenderSchedule"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "taxpayer": {
      "$ref": "#/$defs/RenderTaxpayer"
    },
    "validation": {
      "items": {
        "$ref": "#/$defs/RenderValidationMessage"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "form",
    "locale",
    "taxpayer",
    "period",
    "fields",
    "schedules",
    "validation"
  ],
  "title": "RenderEnvelopeV1",
  "type": "object"
}
