+        /**
+         * The composition as the text itself has it, falling back to what this
+         * connection last saw. A restarted input method can replay its cached
+         * composition through a new connection; the cached field is empty then,
+         * while the composing span in the text still says what is already there.
+         */
+        private CharSequence composingBefore() {
+            Editable current = edit.getText();
+            int start = current == null ? -1 : BaseInputConnection.getComposingSpanStart(current);
+            int end = current == null ? -1 : BaseInputConnection.getComposingSpanEnd(current);
+            if (start >= 0 && end >= 0) {
+                int first = Math.min(start, end), last = Math.max(start, end);
+                if (last <= current.length()) return current.subSequence(first, last);
+            }
+            return composing;
+        }
