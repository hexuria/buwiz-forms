{
  "name": "eBIRForms",
  "id": "dev.goldcoders.bir",
  "version": "0.2.1",
  "build": 27,
  "rust": ".",
  "icon": {
    "macos": "../assets/icon.png",
    "windows": "../assets/icon.png",
    "linux": "../assets/icon.png",
    "android": "../assets/icon.png",
    "web": "../assets/icon.png",
    "ios": "../assets/ios/icon-1024.png"
  },
  "singleInstance": true,
  "macos": {
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "eBIRForms connects to a device on your local network only if you enter one as the mail server for receipt tracking.",
      "NSScreenCaptureUsageDescription": "eBIRForms captures its own window so an agent can take a screenshot of the painted form (not the rest of the desktop)."
    },
    "entitlements": {
      "com.apple.security.network.client": true
    }
  },
  "ios": {
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "UIDeviceFamily": [
        1,
        2
      ]
    },
    "launchScreen": {
      "background": {
        "light": "#f4f4f6",
        "dark": "#0e0e10"
      }
    }
  },
  "android": {
    "targetSdk": 36,
    "allowBackup": false
  },
  "updater": {
    "github": "hexuria/buwiz-forms",
    "publicKey": "azPTfgyyZg7ggQ6w52Rx/Ma9BLfMVjnTvqOflxfMhsc="
  },
  "appearance": "system",
  "theme": "theme/theme.json",
  "window": {
    "title": "eBIRForms",
    "defaultSize": {
      "width": 1440,
      "height": 900
    },
    "minSize": {
      "width": 420,
      "height": 480
    },
    "titleBar": {
      "style": "hidden",
      "height": 40
    },
    "restoreBounds": true
  },
  "tailwind": {
    "fontSize": {
      "page": [
        20,
        1.4
      ],
      "title": [
        16,
        1.4
      ],
      "emph": [
        14,
        1.45
      ],
      "body": [
        13,
        1.5
      ],
      "meta": [
        12,
        1.5
      ],
      "cap": [
        11,
        1.45
      ]
    },
    "breakpoints": {
      "wide": 600,
      "content": 640,
      "partnav": 760,
      "docked": 860
    }
  }
}
