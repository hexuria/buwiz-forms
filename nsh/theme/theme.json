{
  "cssVars": {
    "theme": {
      "font-sans": "Inter, sans-serif",
      "font-mono": "ui-monospace, monospace",
      "radius": "6px",
      "radius-ctl": "6px",
      "radius-row": "8px",
      "radius-card": "12px",
      "radius-dialog": "14px"
    },
    "light": {
      "background": "#f4f4f6",
      "foreground": "#18181b",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "raised": "#ffffff",
      "popover": "var(--raised)",
      "popover-foreground": "var(--foreground)",
      "hover": "#ebebee",
      "selected": "#e2e2e7",
      "secondary": "var(--hover)",
      "secondary-foreground": "var(--foreground)",
      "muted": "var(--hover)",
      "muted-foreground": "#54545d",
      "subtle-foreground": "#64646d",
      "accent": "var(--selected)",
      "accent-foreground": "var(--foreground)",
      "primary": "#18181b",
      "primary-foreground": "#ffffff",
      "border": "#e2e2e6",
      "border-strong": "#cdcdd3",
      "input": "var(--border-strong)",
      "accent-blue": "#2557d6",
      "accent-blue-soft": "#2557d61a",
      "ring": "var(--accent-blue)",
      "success": "#157a3c",
      "success-soft": "#157a3c1a",
      "warning": "#a5520a",
      "warning-soft": "#c46e0a21",
      "danger": "#c0262d",
      "danger-soft": "#c0262d1a",
      "destructive": "var(--danger)",
      "destructive-foreground": "var(--primary-foreground)",
      "scrim": "#18181b4d",
      "knob": "#ffffff",
      "caption-close": "#c42b1c",
      "caption-close-foreground": "#ffffff",
      "sidebar": "var(--background)",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-accent": "var(--selected)",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "var(--border)",
      "sidebar-ring": "var(--accent-blue)"
    },
    "dark": {
      "background": "#0e0e10",
      "foreground": "#f3f3f5",
      "card": "#161619",
      "raised": "#232328",
      "hover": "#1f1f23",
      "selected": "#29292f",
      "muted-foreground": "#a7a7b1",
      "subtle-foreground": "#91919b",
      "primary": "#f3f3f5",
      "primary-foreground": "#111113",
      "border": "#25252a",
      "border-strong": "#38383f",
      "accent-blue": "#7ea2ff",
      "accent-blue-soft": "#7ea2ff24",
      "success": "#5bd68a",
      "success-soft": "#5bd68a1f",
      "warning": "#f3b44a",
      "warning-soft": "#f3b44a21",
      "danger": "#ff7b7b",
      "danger-soft": "#ff7b7b1f",
      "scrim": "#0000008c",
      "knob": "#ffffff",
      "caption-close": "#c42b1c",
      "caption-close-foreground": "#ffffff"
    }
  }
}
