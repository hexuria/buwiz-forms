{
  "id": "2551Qv2018",
  "title": "Quarterly Percentage Tax Return",
  "pages": [
    {
      "title": "Part I - Background Information",
      "sections": [
        {
          "title": "Filing Period",
          "fields": [
            { "name": "frm2551Qv2018:forThe_1", "label": "Calendar", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:forThe_2", "label": "Fiscal", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:rtnMonth", "label": "Return Month", "field_type": { "type": "Text", "max_length": 2 } },
            { "name": "frm2551Qv2018:txtYear", "label": "Year", "field_type": { "type": "Text", "max_length": 4, "pattern": "^\\d{4}$" }, "required": true },
            { "name": "frm2551Qv2018:qtr_1", "label": "1st Quarter", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:qtr_2", "label": "2nd Quarter", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:qtr_3", "label": "3rd Quarter", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:qtr_4", "label": "4th Quarter", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:amendedRtn_1", "label": "Amended Return Yes", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:amendedRtn_2", "label": "Amended Return No", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:txtSheets", "label": "No. of Sheets Attached", "field_type": { "type": "Text", "max_length": 2 } }
          ]
        },
        {
          "title": "Taxpayer Information",
          "fields": [
            { "name": "frm2551Qv2018:txtTIN1", "label": "TIN Part 1", "field_type": { "type": "Text", "max_length": 3 } },
            { "name": "frm2551Qv2018:txtTIN2", "label": "TIN Part 2", "field_type": { "type": "Text", "max_length": 3 } },
            { "name": "frm2551Qv2018:txtTIN3", "label": "TIN Part 3", "field_type": { "type": "Text", "max_length": 3 } },
            { "name": "frm2551Qv2018:txtBranchCode", "label": "Branch Code", "field_type": { "type": "Text", "max_length": 5 } },
            { "name": "frm2551Qv2018:txtRDOCode", "label": "RDO Code", "field_type": { "type": "RdoSelect" } },
            { "name": "frm2551Qv2018:registeredName", "label": "Registered Name", "field_type": { "type": "Text", "max_length": 100 } },
            { "name": "frm2551Qv2018:registeredAddress", "label": "Registered Address", "field_type": { "type": "Text", "max_length": 200 } },
            { "name": "frm2551Qv2018:zipCode", "label": "Zip Code", "field_type": { "type": "Text", "max_length": 4 } },
            { "name": "frm2551Qv2018:telNo", "label": "Telephone Number", "field_type": { "type": "Text", "max_length": 20 } },
            { "name": "txtEmail", "label": "Email Address", "field_type": { "type": "Text", "max_length": 100 } },
            { "name": "frm2551Qv2018:taxTreaty_1", "label": "Tax Treaty Yes", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:taxTreaty_2", "label": "Tax Treaty No", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:txtTaxReliefSpecify", "label": "Tax Relief Specify", "field_type": { "type": "Text", "max_length": 100 } }
          ]
        }
      ]
    },
    {
      "title": "Part II - Computation of Tax",
      "sections": [
        {
          "title": "Tax Computation",
          "fields": [
            { "name": "frm2551Qv2018:taxRate1", "label": "Tax Rate 1", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:taxRate2", "label": "Tax Rate 2", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:txt14", "label": "Total Tax Due", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt15", "label": "Less: Creditable Percentage Tax Withheld", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt16", "label": "Tax Paid in Return Previously Filed", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt17Specify", "label": "Other Credits/Payments Specify", "field_type": { "type": "Text", "max_length": 100 } },
            { "name": "frm2551Qv2018:txt17", "label": "Other Credits/Payments", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt18", "label": "Total Tax Credits/Payments", "field_type": { "type": "Computed", "formula": "frm2551Qv2018:txt15 + frm2551Qv2018:txt16 + frm2551Qv2018:txt17" } },
            { "name": "frm2551Qv2018:txt19", "label": "Tax Still Due / Overpayment", "field_type": { "type": "Computed", "formula": "frm2551Qv2018:txt14 - frm2551Qv2018:txt18" } },
            { "name": "frm2551Qv2018:txt20", "label": "Surcharge", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt21", "label": "Interest", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt22", "label": "Compromise", "field_type": { "type": "Currency" } },
            { "name": "frm2551Qv2018:txt23", "label": "Total Penalties", "field_type": { "type": "Computed", "formula": "frm2551Qv2018:txt20 + frm2551Qv2018:txt21 + frm2551Qv2018:txt22" } },
            { "name": "frm2551Qv2018:txt24", "label": "Total Amount Payable", "field_type": { "type": "Computed", "formula": "frm2551Qv2018:txt19 + frm2551Qv2018:txt23" } },
            { "name": "frm2551Qv2018:overPayment1", "label": "Overpayment: Refund", "field_type": { "type": "Checkbox" } },
            { "name": "frm2551Qv2018:overPayment2", "label": "Overpayment: Tax Credit", "field_type": { "type": "Checkbox" } }
          ]
        }
      ]
    },
    {
      "title": "Schedule 1 - Aliquot Parts",
      "sections": [
        {
          "title": "ATC Computation",
          "fields": [
            { "name": "drpATC1", "label": "ATC 1", "field_type": { "type": "AtcSelect" } },
            { "name": "txtATCAmt1", "label": "ATC Amount 1", "field_type": { "type": "Currency" } },
            { "name": "txtATCRate1", "label": "ATC Rate 1", "field_type": { "type": "Text", "max_length": 5 } },
            { "name": "txtATCDue1", "label": "ATC Due 1", "field_type": { "type": "Computed", "formula": "txtATCAmt1 * txtATCRate1" } },
            { "name": "txtTotalSched1", "label": "Total ATC Due", "field_type": { "type": "Computed", "formula": "txtATCDue1" } }
          ]
        }
      ]
    }
  ]
}
