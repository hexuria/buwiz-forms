# Desktop OAuth client used by Gmail OAuth and per-profile Google Calendar sync, for local builds only. Release
# builds carry it only when the repository variable STORE_GMAIL is 1 (none in 1.0.0).
# Create an OAuth desktop client in Google Cloud Console, enable the Gmail and
# Calendar APIs, and copy the client id/secret below. Detailed setup notes are
# internal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMAP_EMAIL=
IMAP_APP_PASSWORD=
DEVELOPER_MODE=true

# Apple Developer Notarization Credentials
APPLE_ID=
APPLE_TEAM_ID=
SIGNING_IDENTITY=
RELEASE_SIGNING_IDENTITY=
APP_PASSWORD=

# Optional SFTP override. If BIR_SFTP_HOST is set, dispatcher is skipped.
# Port defaults to 22. This is not a BIR filing if you point at a lab host.
# Without bir-core's `direct-bir` cargo feature (no build that ships has it)
# the host must be 127.0.0.1 or ::1: the local mock (`just mock-bir`).
# Incomplete BIR_SFTP_* is a config error (no fallthrough to dispatcher).
# BIR_SFTP_HOST=
# BIR_SFTP_PORT=22
# BIR_SFTP_USERNAME=
# BIR_SFTP_PASSWORD=
# BIR_SFTP_FOLDER=
# Lab host-key: pin SHA-256 hex, or ACCEPT_ANY for a known lab host.
# Official dispatcher still uses accept-any (ebfSFTP GiveUpSecurityAndAcceptAny).
# BIR_SFTP_HOST_KEY_SHA256=
# BIR_SFTP_ACCEPT_ANY_HOST_KEY=1
# In-process fake PUT (no TCP, no dispatcher, no BIR). Not a filing.
# BIR_SFTP_DRY_RUN=1
# Production tinDispatcherSFTP.php is compiled only with bir-core's `direct-bir`
# cargo feature. Any other build has nowhere to send with BIR_SFTP_LIVE=1: it
# refuses to queue a return and leaves queued ones alone.
# BIR_SFTP_LIVE=0 is dry-run. BIR_SFTP_LIVE=1 allows dispatcher (HTTPS then HTTP)
# in a `direct-bir` build.
# BIR_SFTP_LIVE=1
