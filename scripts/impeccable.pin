# Pins for the impeccable verification CLI and its agent skill. The only place
# these versions live: scripts/setup-impeccable.sh (sourced by setup-linux.sh
# and setup-macos.sh), scripts/setup-windows.ps1 and
# docs/platforms/devin-blueprint.yml all read this file. One KEY=value per
# line, no spaces or trailing comments.
#
# IMPECCABLE_VERSION       crates.io version of the `impeccable` CLI
# IMPECCABLE_SKILL_COMMIT  hexuria/impeccable-rust commit the skill/ files come from
# CARGO_BINSTALL_VERSION   prebuilt cargo-binstall the Devin Linux blueprint installs
IMPECCABLE_VERSION=0.2.0
IMPECCABLE_SKILL_COMMIT=6c52a01007b260b71183b7599e8afa0bc26799ed
CARGO_BINSTALL_VERSION=1.24.0
