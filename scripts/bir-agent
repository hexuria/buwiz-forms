#!/usr/bin/env bash
# Talk to the eBIRForms agent host, with the irreversible verbs removed.
#
# WHY THIS EXISTS RATHER THAN CALLING `gpui-agent` DIRECTLY
#
# The eBIRForms host exposes verbs that file a real return with a real tax authority, or record a
# real payment. None of them can be taken back. The `ebirforms` skill tells the bot never to call
# them — but a skill is prose in a prompt, and prose is the half of a policy that an attacker
# argues with. A rule that lives only in the prompt has no second enforcement point.
#
# This wrapper is that second point. It refuses the filing verbs before they reach the host, so
# "prepare and validate, the person files" is true even if the model is talked out of it.
#
# It also keeps the token out of the permission rule. The reverse-exec allowlist matches on a
# command's leading words, so allowing `GPUI_AGENT_TOKEN=… gpui-agent invoke` would write the
# secret into the rule. Allowing `bir-agent` does not.
set -euo pipefail

: "${GPUI_AGENT_ADDR:=127.0.0.1:17431}"
: "${GPUI_AGENT_TOKEN:=bir-dev}"
export GPUI_AGENT_ADDR GPUI_AGENT_TOKEN

# Sends a return, or records money as paid. The person does these, from the app, themselves.
readonly REFUSED=(
    form.file form.submit form.submit_external
    filing.file filing.submit
    form.mark_paid payment.mark_paid
    form.release_abandoned_claim
)

usage() {
    cat >&2 <<'TEXT'
usage: bir-agent <gpui-agent arguments>

  bir-agent hello
  bir-agent invoke profile.list
  bir-agent invoke profile.set --arg tin=00000000000000
  bir-agent invoke dues.list
  bir-agent invoke form.open --arg code=1601C --arg year=2026 --arg period=9
  bir-agent invoke form.fields
  bir-agent invoke form.fill --arg fields='{"tax_14":"250000"}'
  bir-agent invoke form.validate

Filing and payment verbs are refused here; do those in the app.
TEXT
}

[ $# -gt 0 ] || { usage; exit 2; }

# Only `invoke` names a verb, and it is the word right after it. Checking any other position would
# refuse a taxpayer whose name happened to contain one of these strings.
if [ "${1:-}" = "invoke" ]; then
    verb="${2:-}"
    for refused in "${REFUSED[@]}"; do
        if [ "$verb" = "$refused" ]; then
            cat >&2 <<TEXT
refused here: \`$verb\` files a return or records a payment, and cannot be undone.

Prepare the return instead, and let the person file it:
  bir-agent invoke form.validate     # says whether it is ready
  bir-agent invoke form.save_draft   # keeps the work

Then tell them it is ready and let them press the button in eBIRForms.
TEXT
            exit 3
        fi
    done
fi

exec gpui-agent "$@"
