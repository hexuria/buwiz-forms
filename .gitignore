# Test artifacts
/test-output/

# Calibration scratch and test artifacts — large, machine-local, never evidence.
# `tmp/` holds built app binaries and release zips; committing either would put
# hundreds of megabytes of non-reproducible output into the corpus history.
/tmp/
/test-results/

# Generated PDF files
*.pdf

*.lock
!/Cargo.lock

# AI Agent Artifacts & Scratchpads
.scratch/
.agents/
.antigravitycli/

# Runtime logs — never commit these
*.log
crash.log
debug.log
dispatch.log
error.log

# CI/dev generated artifacts — use justfile targets, not committed files
clippy_errors.txt
test_errors.txt

# Local interpreter and frontend build output
**/__pycache__/
*.py[cod]
/.ruff_cache/

