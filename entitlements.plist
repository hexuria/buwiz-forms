<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox for App Store and SMAppService compliance -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network access (IMAP, FTP, HTTP) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Localhost listener used for Google OAuth desktop callbacks -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Application Identifiers for TestFlight/App Store -->
    <key>com.apple.application-identifier</key>
    <string>5KZ8MD34QW.dev.goldcoders.bir</string>
    <key>com.apple.developer.team-identifier</key>
    <string>5KZ8MD34QW</string>
    <!-- File access via user-initiated dialogs (rfd) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
